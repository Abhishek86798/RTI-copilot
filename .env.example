# Neon Postgres (via Vercel Marketplace) — Phase 0/4
DATABASE_URL=

# Clerk — Phase 0/4
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Resend — Phase 4
RESEND_API_KEY=

# LLM providers — Phase 1 (both free, no credit card required)
# Gemini: get a key at https://aistudio.google.com/apikey (primary model)
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq: get a key at https://console.groq.com/keys (fallback if Gemini rate-limits)
GROQ_API_KEY=

# Signed-in persistence (Neon Postgres, free tier)
DATABASE_URL=

# Deadline emails. Without a key the sweep logs the mail instead of sending it,
# so the pipeline is testable before a sender domain is verified.
# Free tier, no card: https://resend.com
RESEND_API_KEY=
RESEND_FROM="RTI Copilot <onboarding@resend.dev>"

# Shared secret for /api/cron/sweep. Vercel Cron sends it as a Bearer token.
# Without it the endpoint is a public trigger for emailing every user.
CRON_SECRET=
