# Every value here is optional. With none of them set the app still runs the
# full guest journey: routing falls back to fixtures, applications live in the
# browser, and mail is written to the console instead of sent.

# --- Sign-in -----------------------------------------------------------------

# Signs the session cookie. Required in production, where a missing value
# throws rather than falling back to something guessable. Development
# generates a per-process secret, so a fresh clone runs with no setup and
# restarting the dev server signs everyone out.
#   openssl rand -base64 32
AUTH_SECRET=

# Sign-in codes are the fixed 1234 whenever mail cannot actually be delivered
# (see RESEND_API_KEY below), and the dialog says so on screen. Set this to
# "off" once a sender domain is verified to switch to real random codes.
AUTH_DEV_OTP=

# --- LLM providers -----------------------------------------------------------

# Both free, no card required. Gemini is primary, Groq is the fallback when
# Gemini rate-limits — its free tier allows 5 requests per minute, which a
# test run exhausts quickly.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=

# Used only by the routing measurement harness in tests/, as a third fallback
# when both of the above are rate-limited. Not read by the app itself.
OPENROUTER_API_KEY=

# --- Storage -----------------------------------------------------------------

# Signed-in persistence (Neon Postgres, free tier). Without it the signed-in
# API returns 503 and guest mode carries the whole journey.
DATABASE_URL=

# --- Mail --------------------------------------------------------------------

# Deadline notices and sign-in codes. Without a key both are logged to the
# console, so the pipeline is testable before a sender domain exists.
# Free tier, no card: https://resend.com
RESEND_API_KEY=
# The shared onboarding@resend.dev sender only delivers to the Resend account
# owner's own address — everyone else is silently blocked. Sending to real
# people needs a verified domain and an address on it here.
RESEND_FROM="RTI Copilot <onboarding@resend.dev>"

# --- Cron --------------------------------------------------------------------

# Shared secret for /api/cron/sweep, sent by Vercel Cron as a Bearer token.
# Without it the endpoint is an unauthenticated trigger for emailing every
# user, so set it on any deployment that has a database.
CRON_SECRET=

# Absolute URL used in deadline emails. Falls back to the Vercel-provided
# host, then to localhost.
NEXT_PUBLIC_APP_URL=
